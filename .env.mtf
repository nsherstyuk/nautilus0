# =============================================================================
# MTF ML STRATEGY CONFIGURATION
# Separate from old strategy configuration
# =============================================================================

# =============================================================================
# IBKR CONNECTION
# =============================================================================
MTF_IB_HOST=127.0.0.1
MTF_IB_PORT=7497
MTF_IB_CLIENT_ID=19
MTF_IB_ACCOUNT=DU1558484
MTF_IB_MARKET_DATA_TYPE=REALTIME

# =============================================================================
# BACKTEST CONFIGURATION
# =============================================================================
MTF_BACKTEST_START_DATE=2024-01-01
MTF_BACKTEST_END_DATE=2025-12-31
MTF_BACKTEST_SYMBOL=EUR/USD
MTF_BACKTEST_VENUE=IDEALPRO
MTF_BACKTEST_BAR_SPEC=15-MINUTE-MID-EXTERNAL

# =============================================================================
# STRATEGY PARAMETERS
# =============================================================================
# ML Model
MTF_MODEL_PATH=models/ml_model_mtf.pkl
MTF_PREDICTION_THRESHOLD=0.55
MTF_FEATURE_WARMUP_BARS=100

# Position Sizing
MTF_POSITION_SIZE=100000
MTF_MAX_POSITIONS=1

# Risk Management (ATR-based)
MTF_SL_ATR_MULT=1.5
MTF_TP_ATR_MULT=2.5

# Trailing Stop
MTF_TRAILING_STOP_ENABLED=true
MTF_TRAILING_ACTIVATION_ATR_MULT=3.0
MTF_TRAILING_DISTANCE_ATR_MULT=0.5

# Partial Close (OPTIMIZED)
MTF_PARTIAL_CLOSE_ENABLED=true
MTF_PARTIAL_CLOSE_FRACTION=0.5
MTF_PARTIAL_CLOSE_ATR_MULT=2.5
MTF_PARTIAL_CLOSE_MOVE_SL_TO_BE=true

# =============================================================================
# TRADING SESSION
# =============================================================================
# Set to 24/7 trading (00:00-23:59)
MTF_SESSION_START=00:00
MTF_SESSION_END=23:59

# Weekday-specific excluded hours
# No exclusions - trade all hours for maximum robustness
MTF_EXCLUDED_HOURS_MONDAY=
MTF_EXCLUDED_HOURS_TUESDAY=
MTF_EXCLUDED_HOURS_WEDNESDAY=
MTF_EXCLUDED_HOURS_THURSDAY=
MTF_EXCLUDED_HOURS_FRIDAY=
MTF_EXCLUDED_HOURS_SATURDAY=
MTF_EXCLUDED_HOURS_SUNDAY=

# Legacy: Global excluded hours (leave empty if using weekday-specific)
MTF_EXCLUDED_HOURS=

# =============================================================================
# FILTERS
# =============================================================================
MTF_MIN_ATR=0.0003
MTF_MAX_ATR=0.0050
MTF_COOLDOWN_MINUTES=30

# =============================================================================
# LOGGING
# =============================================================================
MTF_LOG_DIR=logs/live_mtf
MTF_LOG_LEVEL=INFO

# =============================================================================
# OUTPUT
# =============================================================================
MTF_BACKTEST_OUTPUT_DIR=logs/backtest_results
