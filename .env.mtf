# =============================================================================
# MTF ML STRATEGY CONFIGURATION
# Separate from old strategy configuration
# =============================================================================

# =============================================================================
# IBKR CONNECTION
# =============================================================================
MTF_IB_HOST=127.0.0.1
MTF_IB_PORT=7497
MTF_IB_CLIENT_ID=19
MTF_IB_ACCOUNT=DU1558484
MTF_IB_MARKET_DATA_TYPE=REALTIME

# =============================================================================
# BACKTEST CONFIGURATION
# =============================================================================
MTF_BACKTEST_START_DATE=2024-01-01
MTF_BACKTEST_END_DATE=2025-12-30
MTF_BACKTEST_SYMBOL=EUR/USD
MTF_BACKTEST_VENUE=IDEALPRO
MTF_BACKTEST_BAR_SPEC=15-MINUTE-MID-EXTERNAL

# =============================================================================
# STRATEGY PARAMETERS
# =============================================================================
# ML Model
MTF_MODEL_PATH=models/ml_model_mtf.pkl
MTF_PREDICTION_THRESHOLD=0.55
MTF_FEATURE_WARMUP_BARS=100

# Position Sizing
MTF_POSITION_SIZE=100000
MTF_MAX_POSITIONS=1

# Risk Management
# Stop loss distance (ATR multiplier) - OPTIMIZED from grid search
MTF_SL_ATR_MULT=1.4

# Take profit distance (ATR multiplier) - OPTIMIZED
# Acts as early profit lock in this configuration
MTF_TP_ATR_MULT=3.0

# Trailing Stop - OPTIMIZED (activation matches L1 trigger)
MTF_TRAILING_STOP_ENABLED=true
MTF_TRAILING_ACTIVATION_ATR_MULT=0.9
MTF_TRAILING_DISTANCE_ATR_MULT=0.5

# Partial Close (OPTIMIZED)
MTF_PARTIAL_CLOSE_ENABLED=true
MTF_PARTIAL_CLOSE_FRACTION=0.5
MTF_PARTIAL_CLOSE_ATR_MULT=2.5
MTF_PARTIAL_CLOSE_MOVE_SL_TO_BE=true

# =============================================================================
# TRADING SESSION
# =============================================================================
# Set to 24/7 trading (00:00-23:59)
MTF_SESSION_START=00:00
MTF_SESSION_END=23:59

# Weekday-specific excluded hours
# Only hour 6 excluded on all days
MTF_EXCLUDED_HOURS_MONDAY=6
MTF_EXCLUDED_HOURS_TUESDAY=6
MTF_EXCLUDED_HOURS_WEDNESDAY=6
MTF_EXCLUDED_HOURS_THURSDAY=6
MTF_EXCLUDED_HOURS_FRIDAY=6
MTF_EXCLUDED_HOURS_SATURDAY=6
MTF_EXCLUDED_HOURS_SUNDAY=6
    

# Legacy: Global excluded hours (leave empty if using weekday-specific)
MTF_EXCLUDED_HOURS=


# =============================================================================
# FILTERS
# =============================================================================
MTF_MIN_ATR=0.0003
MTF_MAX_ATR=0.0050
MTF_COOLDOWN_MINUTES=30

# =============================================================================
# LOGGING
# =============================================================================
MTF_LOG_DIR=logs/live_mtf
MTF_LOG_LEVEL=INFO

# =============================================================================
# OUTPUT
# =============================================================================
MTF_BACKTEST_OUTPUT_DIR=logs/backtest_results

# =============================================================================
# MULTI-LAYER EXIT TESTING (EXPERIMENTAL)
# =============================================================================
# Enable multi-layer partial closes (set to false to use standard partial close)
# OPTIMIZED: Using 75/15/10 configuration
MTF_MULTI_LAYER_ENABLED=true

# Number of exit layers (2-4 recommended)
MTF_MULTI_LAYER_COUNT=3

# Size of each layer as fraction of position (must sum to 1.0)
# Format: comma-separated values
# OPTIMIZED: 70/25/5 - Best balance (0 neg months, fewest neg days)
MTF_MULTI_LAYER_SIZES=0.7,0.25,0.05

# Trigger for each layer in ATR multiples
# Format: comma-separated values
# Special values: 
#   - Positive number (e.g., 2.0) = profit in ATR units
#   - 0.0 = breakeven (entry price)
#   - "final" = exit at final stop/target
# OPTIMIZED: 1st at 0.9xATR, 2nd at 1.75xATR, 3rd at final exit
# Best result: $31,268 PnL, 0 negative months, 106 neg days
MTF_MULTI_LAYER_TRIGGERS=0.9,1.75,final

# Move stop loss to breakeven after first layer closes
MTF_MULTI_LAYER_MOVE_SL_TO_BE=true
