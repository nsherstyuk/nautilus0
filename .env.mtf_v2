####################################################################################
# SEASONAL HOUR×WEEKDAY EXCLUSIONS
####################################################################################
# Based on 2024-2025 cross-year stability analysis
# Format: hour-weekday pairs (hour=0-23 EST, weekday=1=Mon...7=Sun)
# These exclude specific hour+weekday combinations that were consistently negative
# in both 2024 and 2025 (≥60% negative months in each year)

# Enable/disable seasonal filtering
MTF2_SEASONAL_HOUR_EXCLUSIONS_ENABLED=false

# DJF (Dec-Jan-Feb) exclusions - Winter
# 16:00 on Mon/Wed/Fri (keeps profitable Thu/Tue)
# 14:00 on Wed/Fri (keeps profitable Mon/Thu)
# 15:00 on Mon/Wed/Fri
MTF2_DJF_EXCLUDED_HOUR_WEEKDAY_PAIRS=16-1,16-3,16-5,14-3,14-5,15-1,15-3,15-5

# MAM (Mar-Apr-May) exclusions - Spring
# Skipped: patterns not reliably repeating year-to-year
MTF2_MAM_EXCLUDED_HOUR_WEEKDAY_PAIRS=

# JJA (Jun-Jul-Aug) exclusions - Summer
# 17:00 on Mon/Wed/Thu
# 16:00 on Wed/Fri
MTF2_JJA_EXCLUDED_HOUR_WEEKDAY_PAIRS=17-1,17-3,17-4,16-3,16-5

# SON (Sep-Oct-Nov) exclusions - Fall
# 14:00 on Mon/Tue/Wed/Fri (keeps profitable Thu)
MTF2_SON_EXCLUDED_HOUR_WEEKDAY_PAIRS=14-1,14-2,14-3,14-5

