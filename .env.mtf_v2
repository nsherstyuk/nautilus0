# Position Sizing (2-position split)

MTF2_TOTAL_POSITION_SIZE=25000    #50000        #100000



MTF2_POS1_FRACTION=1.0            #0.85
MTF2_POS2_FRACTION=0.00              #0.15
MTF2_POS3_FRACTION=0.00

# Stop Loss (Optimized from full optimization: 1.2x ATR)
MTF2_SL_ATR_MULT= 1.2 #1.2

# Confidence-tiered SL (Entry-Confirmed V2 strategy)
#
# Purpose:
# - Optionally override the *base* stop-loss multiplier based on the model confidence
#   of each generated signal.
# - TP is unchanged; only SL distance is adjusted.
#
# Enable/disable:
# - When disabled, strategy always uses MTF2_SL_ATR_MULT.
# - When enabled, strategy picks the first matching tier where confidence >= min_conf.
#
# Interpolation:
# - When MTF2_CONF_SL_INTERPOLATE=true, strategy linearly interpolates sl_atr_mult between
#   adjacent tier points, then rounds to 2 decimals (e.g., 0.95).
# - When false, strategy uses step-function tiers.
#
# Format:
# - MTF2_CONF_SL_TIERS is a comma-separated list of "min_conf:sl_atr_mult".
# - Example: "0.85:1.00,0.90:0.90"
#   - confidence >= 0.90  -> sl_atr_mult = 0.90 (tighter)
#   - confidence >= 0.85  -> sl_atr_mult = 1.00
#   - otherwise           -> sl_atr_mult = MTF2_SL_ATR_MULT
#
# Verification:
# - On startup you should see in strategy logs:
#   "Confidence SL: ENABLED tiers=..." (or DISABLED)  true
MTF2_CONF_SL_ENABLED=false
MTF2_CONF_SL_INTERPOLATE=false
MTF2_CONF_SL_TIERS=0.69:1.20,0.75:1.10,0.78:1.00,0.82:0.90,0.85:0.85

#MTF2_CONF_SL_TIERS=0.69:1.25,0.7:1.2,0.71:1.18,0.72:1.17,0.73:1.09,0.74:1.05,0.75:1.04,0.76:1.04,0.77:1.03,0.78:1.02,0.79:1.01,0.8:1.00,0.81:0.99,0.82:0.98,0.83:0.97,0.84:0.96,0.85:0.96,0.86:0.96,0.87:0.95,0.88:0.94,0.89:0.93,0.9:0.92,0.91:0.91,0.93:0.90,0.95:0.91

# Take Profit per position (Optimized: TP1=0.6x, TP2=2.0x)
MTF2_POS1_TP_ATR_MULT= 0.6  #0.6 0.7 0.95
MTF2_POS2_TP_ATR_MULT=2.0
MTF2_POS3_TP_ATR_MULT=1.5

# Trailing Stop (for Position 2 after Pos1 TP hit)
MTF2_TRAILING_ACTIVATION_ATR_MULT=0.6
MTF2_TRAILING_DISTANCE_ATR_MULT=0.4

# Stall Detection (Optimized: Check=2, MinProfit=0.3, SL=0.05)
MTF2_STALL_DETECTION_ENABLED=false      # false
