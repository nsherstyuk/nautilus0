# Example configuration for seasonal hour×weekday exclusions
# Copy relevant lines to .env.mtf_v2 to enable

# Enable/disable seasonal filtering
MTF2_SEASONAL_HOUR_EXCLUSIONS_ENABLED=1

# DJF (Dec-Jan-Feb) exclusions
# Based on cross-year analysis: 16:00 (all days except Thu/Tue), 14:00 (Wed/Fri), 15:00 (Mon/Wed/Fri)
# Format: hour-weekday where hour=0-23 EST, weekday=1-7 (1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat, 7=Sun)
MTF2_DJF_EXCLUDED_HOUR_WEEKDAY_PAIRS=16-1,16-3,16-5,14-3,14-5,15-1,15-3,15-5

# MAM (Mar-Apr-May) exclusions
# Weak/unreliable patterns - skipped

# JJA (Jun-Jul-Aug) exclusions
# 17:00 (Mon/Wed/Thu), 16:00 (Wed/Fri)
MTF2_JJA_EXCLUDED_HOUR_WEEKDAY_PAIRS=17-1,17-3,17-4,16-3,16-5

# SON (Sep-Oct-Nov) exclusions
# 14:00 (Mon/Tue/Wed/Fri - but keep Thu which is positive)
MTF2_SON_EXCLUDED_HOUR_WEEKDAY_PAIRS=14-1,14-2,14-3,14-5

# Note: These can work alongside existing excluded_hours_mode settings
# The seasonal exclusions are checked AFTER other time filters
